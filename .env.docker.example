# Шаблон для docker compose (полный стек). Скопируйте в .env.docker и заполните секреты.
# Файл .env.docker не коммитить.

# ── Backend ────────────────────────────────────────────────────────────────────
BOT_SECRET=change-me-shared-with-bot
ADMIN_API_TOKEN=change-me-admin-token
ADMIN_ACTOR_USER_ID=00000000-0000-0000-0000-0000000000aa
LOG_LEVEL=INFO

# OpenRouter — LLM и STT (консультация, голос)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SPEECH_TO_TEXT_PROVIDER=openrouter
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_BASE_URL=https://openrouter.ai/api/v1
SPEECH_TO_TEXT_MODEL=openai/whisper-large-v3-turbo

CONSULTATION_LLM_TIMEOUT_SECONDS=45
CONSULTATION_MAX_TOOL_ROUNDS=6

# ── Bot ────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
DISPLAY_TIMEZONE=Europe/Moscow

# BACKEND_BASE_URL задаётся в docker-compose.yml (http://backend:8000)

# ── Web ──────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_BASE_URL — origin backend для браузера (порт проброшен на хост)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_TELEGRAM_BOT_URL=

# ── Registry (docker-compose.registry.yml; iter-dev-02) ───────────────────────
# REGISTRY=ghcr.io/zharkov-ruslan
# IMAGE_TAG=latest
